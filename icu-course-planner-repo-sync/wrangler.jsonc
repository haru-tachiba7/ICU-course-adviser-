{
  "name": "icu-course-compass",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "SYNC", "id": "79899d1982c14f828027ccd658e34a22" }]
}

{
  // ...
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  // ...
}
